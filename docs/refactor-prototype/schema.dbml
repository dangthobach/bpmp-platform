// Audit/soft-delete/version are logical envelope fields; immutable/technical storage mapping: entity-conventions.md
// PROPOSED logical model. Schema names denote separate owners/databases.
// Common UUID IDs are design choices, not claims about existing physical columns.

Table access.organizations {
  tenant_id uuid [not null]
  id uuid [not null]
  code text [not null]
  name text [not null]
  parent_id uuid
  status text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null, default: 1]
  created_by text [not null]
  updated_by text [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by text
  delete_reason text
  indexes {
    (tenant_id, id) [pk]
  }
}

