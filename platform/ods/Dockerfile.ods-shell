FROM node:22.22.0-bookworm-slim AS builder
WORKDIR /workspace
COPY package.json package-lock.json tsconfig.ods.json ./
COPY apps/web/ods-shell/package.json apps/web/ods-shell/package.json
COPY apps/web/task-mfe/package.json apps/web/task-mfe/package.json
COPY packages/frontend/call-api/package.json packages/frontend/call-api/package.json
COPY packages/frontend/mfe-contract/package.json packages/frontend/mfe-contract/package.json
COPY packages/frontend/shared-ui/package.json packages/frontend/shared-ui/package.json
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/web/ods-shell apps/web/ods-shell
COPY packages/frontend packages/frontend
RUN npm run build -w @ods/shell
RUN rm /workspace/apps/web/ods-shell/dist/shell-config.json /workspace/apps/web/ods-shell/dist/mfe-catalog.json

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY platform/ods/nginx-shell.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/web/ods-shell/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
