COMPOSE_PROJECT_NAME=bpmp-local

POSTGRES_IMAGE=postgres:17.5-bookworm
REDPANDA_IMAGE=redpandadata/redpanda:v24.3.18
REDIS_IMAGE=redis:7.4.2-alpine
OTEL_IMAGE=otel/opentelemetry-collector:0.130.1

HUMAN_DB_NAME=human_runtime
HUMAN_DB_USER=bpmp_human
HUMAN_DB_PASSWORD=local-human-change-me
HUMAN_DB_PORT=15432

CONFIGURATION_DB_NAME=configuration
CONFIGURATION_DB_USER=bpmp_configuration
CONFIGURATION_DB_PASSWORD=local-configuration-change-me
CONFIGURATION_DB_PORT=15433

PROJECTION_DB_NAME=projection
PROJECTION_DB_USER=bpmp_projection
PROJECTION_DB_PASSWORD=local-projection-change-me
PROJECTION_DB_PORT=15434

GOVERNANCE_DB_NAME=governance
GOVERNANCE_DB_USER=bpmp_governance
GOVERNANCE_DB_PASSWORD=local-governance-change-me
GOVERNANCE_DB_PORT=15435

KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=19644
REDPANDA_SMP=1
REDPANDA_MEMORY=1G
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_RETENTION_MS=604800000
ENGINE_COMMITTED_EVENTS_TOPIC=bpmp.engine.committed-events.v1.local
CONFIGURATION_PUBLICATIONS_TOPIC=bpmp.configuration.publications.v1.local
HUMAN_ESCALATIONS_TOPIC=bpmp.human.escalations.v1.local

REDIS_PORT=16379
OTEL_GRPC_PORT=14317
MIGRATION_WAIT_TIMEOUT_SECONDS=60
