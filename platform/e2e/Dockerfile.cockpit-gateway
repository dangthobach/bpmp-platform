FROM golang:1.25.12-bookworm AS builder
WORKDIR /workspace
COPY go ./go
COPY apps/go/cockpit-gateway ./apps/go/cockpit-gateway
WORKDIR /workspace/apps/go/cockpit-gateway
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/cockpit-gateway ./cmd/cockpit-gateway

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /out/cockpit-gateway /usr/local/bin/cockpit-gateway
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/cockpit-gateway"]
