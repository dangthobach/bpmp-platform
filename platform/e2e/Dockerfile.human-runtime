FROM golang:1.25.0-bookworm AS builder
WORKDIR /workspace
COPY go ./go
COPY apps/go/human-runtime ./apps/go/human-runtime
WORKDIR /workspace/apps/go/human-runtime
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/human-runtime ./cmd/human-runtime

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/human-runtime /usr/local/bin/human-runtime
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/human-runtime"]
