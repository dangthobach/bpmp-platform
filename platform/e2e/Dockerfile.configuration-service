FROM golang:1.25.0-bookworm AS builder
WORKDIR /workspace
COPY go ./go
COPY apps/go/configuration-service ./apps/go/configuration-service
WORKDIR /workspace/apps/go/configuration-service
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/configuration-service ./cmd/configuration-service

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /out/configuration-service /usr/local/bin/configuration-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/configuration-service"]
