FROM golang:1.25.0-bookworm AS builder
WORKDIR /workspace
COPY go ./go
COPY apps/go/projection-service ./apps/go/projection-service
WORKDIR /workspace/apps/go/projection-service
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/projection-service ./cmd/projection-service

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/projection-service /usr/local/bin/projection-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/projection-service"]
