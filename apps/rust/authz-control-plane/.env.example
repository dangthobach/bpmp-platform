# ============================================================
# AuthZ Platform — Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# -- Database --
AUTHZ_POSTGRES_PORT=15436
DATABASE_URL=postgres://authz:authz_secret@localhost:15436/authz_db
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECS=10
DATABASE_IDLE_TIMEOUT_SECS=300

# -- Kafka tenant lifecycle --
KAFKA_BROKERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=authz-control-plane
KAFKA_MAX_MESSAGE_BYTES=1048576
TENANT_LIFECYCLE_TOPIC=bpmp.tenant.lifecycle.v1.local
AUTHZ_POLICY_BUNDLE_TOPIC=bpmp.authz.policy-bundles.v1.local
AUTHZ_POLICY_BUNDLE_ACK_TOPIC=bpmp.authz.policy-bundle-acknowledgements.v1.local
AUTHZ_POLICY_BUNDLE_ACK_CONSUMER_GROUP=bpmp.authz.policy-bundle-acknowledgements.v1.local
TENANT_READINESS_TOPIC=bpmp.tenant.configuration-readiness.v1.local
TENANT_READINESS_CONSUMER_GROUP=bpmp.authz-control-plane.tenant-readiness.v1.local
TENANT_LIFECYCLE_WORKER_ID=authz-control-plane-local
TENANT_LIFECYCLE_BATCH_SIZE=100
TENANT_LIFECYCLE_LEASE_MS=30000
TENANT_LIFECYCLE_POLL_MS=250
QUERY_REVOKE_KAFKA_CONFIG=./config/query-revoke-kafka.local.json

# Local-only Ed25519 signing keys. Create these files outside source control;
# never commit private key material. Bundle publication is disabled until the
# policy signing key pair is available.
AUTHZ_POLICY_SIGNING_KEY_ID=policy-key-local
AUTHZ_POLICY_SIGNING_KEY_PATH=./secrets/policy-private.key

# -- Server --
SERVICE_NAME=authz-server
HOST=0.0.0.0
PORT=8080
GRPC_PORT=50051
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_MAX_BODY_BYTES=1048576

# -- JWT --
# OpenID Connect JWKS endpoint used to verify service/user bearer tokens.
JWT_JWKS_URL=https://your-keycloak.example.com/realms/enterprise/protocol/openid-connect/certs
JWT_AUDIENCE=authz-platform
AUTHZ_OWNER_MANIFEST_KEY_IDS={"bpmp-engine":["bpmp-engine-k1"],"projection-service":["projection-service-k1"]}
# Required by authz-app when calling the protected PDP routes. Mount the file
# as a secret; do not place the bearer token directly in an environment value.
AUTHZ_SERVICE_TOKEN_FILE=/run/secrets/authz-service-token
# Optional internal Engine -> organization branch-scope resolver. The JSON file
# contains the allowed workload ID, proof bounds, and trusted public keys. The
# current command envelope carries the API Gateway's command-bound workload proof.
# Mount the file and public keys as read-only secrets/config; never put key bytes
# in environment variables.
BRANCH_SCOPE_WORKLOAD_KEYS_FILE=/run/config/branch-scope-workload-keys.json

# -- Observability --
RUST_LOG=info,authz_server=debug,authz_engine=debug
OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_LISTEN_ADDR=0.0.0.0:9090

# -- Policy Engine --
# fail-open (ALLOW) or fail-closed (DENY) when policy bundle unavailable
FAIL_MODE=DENY
# Maximum ReBAC graph traversal depth
REBAC_MAX_DEPTH=10
# Maximum terms in ES/Mongo filter injected from ReBAC
REBAC_MAX_TERMS_FILTER_SIZE=1000

# -- Cache --
# Compiled predicate cache max entries
POLICY_CACHE_MAX_ENTRIES=10000
# User context cache TTL seconds
USER_CONTEXT_CACHE_TTL_SECS=300
# JIT attribute cache TTL seconds
JIT_ATTR_CACHE_TTL_SECS=30

# -- Rate limiting --
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=200

# -- Emergency revoke --
EMERGENCY_REVOKE_TTL_SECS=86400
